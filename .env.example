# TypeSafe / Jev (https://console.typesafe.ai/keys)
# Required for live POST https://api.typesafe.ai/v1/systemone calls.
# Leave empty to use fixtures/jev-mock/ instead of the hosted API.
# Globe country+sentiment uses the same key. Without it, rose-bot maps
# pending articles through fixtures/jev-mock/globe-*.json (same answer shape).
TYPESAFE_API_KEY=

# Optional. Max articles to run through Jev per scrape tick (default 8).
# MAX_JEV_PER_TICK=8

# Optional. Default is https://api.typesafe.ai
# TYPESAFE_ENDPOINT=https://api.typesafe.ai

# Required. Postgres (Railway: ${{Postgres.DATABASE_URL}}). No SQLite.
DATABASE_URL=postgres://user:pass@host:5432/railway

# Optional. If set, GET /sources and POST /crawl accept Authorization: Bearer <token> (or X-Rose-Token / X-Rose-Key).
# Hashed keys minted in rose-web-admin (/keys) also authenticate GET /sources, POST /crawl, and /v1/*.
# ROSE_SERVICE_TOKEN=

# Ethical crawler (off by default). Recursive URL discovery; scrape only allowlisted news.
# See docs/crawler.md. POST /crawl can toggle without restart once ROSE_SERVICE_TOKEN is set.
# CRAWL_ENABLED=0
# CRAWL_SEEDS=https://www.bbc.com/news,https://www.npr.org
# CRAWL_NEWS_DOMAINS=
# CRAWL_MAX_FETCHES_PER_TICK=2
# CRAWL_MAX_NON_NEWS_FETCHES_PER_TICK=0
# CRAWL_MAX_DEPTH=2
# CRAWL_FLOOR_DELAY_MS=5000
# CRAWL_CONTACT=https://github.com/ejqs/newsey/issues
